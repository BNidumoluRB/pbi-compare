# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud -> App -> Settings -> Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore).

[admin]
# Required to edit tenant / client details from the sidebar. Leave empty only for local use.
owner_passcode = "change-me"
# Optional: everyone opening the app (e.g. from the github.io link) must enter this first.
viewer_passcode = "share-with-your-team"

# One block per tenant the app is allowed to work with. The app only talks to these.
[tenants.contoso]
display_name = "Contoso (Prod + Test)"
tenant_id     = "00000000-0000-0000-0000-000000000000"
client_id     = "11111111-1111-1111-1111-111111111111"
client_secret = "your-client-secret"
# Optional: restrict the workspace pickers (IDs or names)
allowed_workspaces = ["Sales Analytics", "Sales Analytics [Test]"]

# Optional: run the generated validation SQL from the app
[tenants.contoso.snowflake]
account   = "acme-xy12345"
user      = "PBI_VALIDATOR"
password  = "..."
warehouse = "ANALYTICS_WH"
role      = "READ_ONLY"
